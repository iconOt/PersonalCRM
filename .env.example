# Personal CRM — InsForge backend configuration
#
# Copy to `.env` and fill in the values for your project.
# Get the anon key with: npx -y @insforge/cli secrets get ANON_KEY
# Get the URL from the `oss_host` field in .insforge/project.json

VITE_INSFORGE_URL=https://your-appkey.us-east.insforge.app
VITE_INSFORGE_ANON_KEY=your-anon-key
